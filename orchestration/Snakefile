"""
Heritage Monitor Pipeline — Snakemake DAG.

Orchestration only: this file and rules/*.smk wire together the ordered steps.
The actual logic lives in src/sources/, src/common/, and src/enrichment/ — this file
never contains pipeline logic itself, only how to invoke it and in what order.

Rule files mirror where the code they invoke lives:
rules/api_runner/   ↔ src/sources/apis/
rules/dumps.smk     ↔ src/sources/dumps/
rules/external/     ↔ src/sources/external/
rules/pipeline/     ↔ pipeline-level code — the merge/enrichment/model/serve
stages, each version's own rules/pipeline/core_vN/. core_v3's data model is
frozen (see src/pipelines/core_v3/README.md), but its merge and enrichment/
subpackage are real, runnable glue — enrichment is prep for core_v4, proven
against core_v3's real data in the meantime. `snakemake core_v3` runs it all.

Each pipeline version gets its own rules/pipeline/core_vN/ once that version has real rules,
rather than stubbing them out in advance.

Run locally:    snakemake --cores 4 <target>
Run on the HPC: snakemake --workflow-profile orchestration/profiles/slurm <target>
"""

import sys
from pathlib import Path

REPO_ROOT = Path(workflow.basedir).parent
sys.path.insert(0, str(REPO_ROOT))

# Rules with a relative shell path (e.g. "bash src/sources/...") only resolve
# correctly if the shell cwd is the repo root. Pin it here so `snakemake` works
# the same whether invoked from orchestration/ (Snakefile auto-discovery)
# or from the repo root via -s orchestration/Snakefile.
workdir: str(REPO_ROOT)

from common.config.api_runner import get_query_settings
from common.config.dumps import get_dumps_paths
from common.config.settings import get_settings

QUERY_SOURCES = ["arxiv", "cordis", "coreac"]  # meta_heritage has no queries

# Base dir for every rule's log: below -- same value for dev/prod (see
# config/config.yaml) and always resolved against the repo checkout, same
# convention as reports/. A fixed, flat path per rule (+ wildcards where
# needed) so a log is always at a known location, overwritten each run --
# not the old per-run-timestamped files under here from the previous logger.
LOGGING_PATH = get_settings().logging_path


include: "rules/api_runner/extract.smk"
include: "rules/api_runner/load.smk"
include: "rules/dumps.smk"
include: "rules/pipeline/core_v3/merge.smk"
include: "rules/pipeline/core_v3/enrichment.smk"
include: "rules/pipeline/core_v4/merge.smk"
include: "rules/pipeline/core_v4/enrichment.smk"
include: "rules/pipeline/core_v4/assemble.smk"
include: "rules/external/meta_heritage.smk"


rule all:
    input:
        _report_targets(),
        rules.ingest_dumps.input,
        f"reports/sources/dumps/{REPORT_NAME_MINORITIES}.md",
        f"reports/sources/dumps/{REPORT_NAME_OA_TOPICS}.md",


# Sources left out of `sources_dev` (see below): coreac isn't ready for an
# unattended default run, and the openaire dump is excluded structurally —
# `sources_dev` simply never lists `stage_openaire_dump`/`ingest_dumps` as
# input, since it's 100s of GB and HPC-only (run `load_openaire_dump` /
# `stage_openaire_dump` by name on the HPC instead — see orchestration/README.md).
LOCAL_EXCLUDE_SOURCES = ["coreac"]


rule extract_sources_dev:
    """Extraction-only half of sources_dev: pulls raw data (api extract +
    ror download + minorities discovery) but doesn't load anything into
    duckdb. oa_topics has no extraction step of its own (its CSV is placed
    manually), so its raw path is listed directly here."""
    input:
        _extract_targets(exclude=LOCAL_EXCLUDE_SOURCES),
        rules.download_ror_dump.output,
        rules.discover_minorities_candidates.output,
        DUMP_PATHS["oa_topics"]["path_raw"],


rule sources_dev:
    """Local-dev-safe extract + load target: every incremental api source
    except LOCAL_EXCLUDE_SOURCES, plus the ror dump, minorities, and oa_topics.
    Deliberately a narrower set than `all` — `all` still includes coreac and
    the openaire dump for full/HPC runs."""
    input:
        _report_targets(exclude=LOCAL_EXCLUDE_SOURCES),
        f"reports/sources/dumps/{REPORT_NAME_ROR_DUMP}.md",
        f"reports/sources/dumps/{REPORT_NAME_MINORITIES}.md",
        f"reports/sources/dumps/{REPORT_NAME_OA_TOPICS}.md",


# core_v3, end to end: sources -> transformation (core_v3_staging.duckdb) ->
# seed_topics + topic_modelling (core_v3_staging_2.duckdb) -> dch_classification
# (core_v3.duckdb) -> one report per duckdb. The merge pulls in the openaire
# staging, ror and cordis loads it reads; their source reports are listed too.
# Doesn't depend on the core_v4_sources rules below. HPC-only (openaire).
#   ENV=prod uv run snakemake --workflow-profile orchestration/profiles/slurm core_v3
# Smoke test on a sample (overwrites core_v3's duckdbs, see merge.smk):
#   ... core_v3 --config limit=500
rule core_v3:
    input:
        f"reports/sources/apis/cordis/{CORE_V3_CORDIS_QUERY_ID}.md",
        f"reports/sources/dumps/{REPORT_NAME_ROR_DUMP}.md",
        f"reports/sources/dumps/{REPORT_NAME_OPENAIRE_DUMP}.md",
        expand("reports/pipelines/core_v3/{stage}.md", stage=CORE_V3_REPORT_STAGES),


### --- Below here is not tested, should not be used yet --- ###


# core_v4_sources source set: cordis's "all cordis docs" query
# (full_projects_no_pdfs, no pdf subset) plus the ror and openaire dumps. Used
# to verify loader idempotency ahead of the core_v4 build -- sources only.
# Enrichment (rules/pipeline/core_v3/enrichment.smk) runs against core_v3's
# already-merged data, not these raw sources directly. Unlike `sources_dev`
# this includes openaire, so it's HPC-only (run with
# --workflow-profile orchestration/profiles/slurm), not part of the
# local-dev-safe set.
CORE_V4_SOURCES_EXCLUDE = ["arxiv", "coreac"]
CORE_V4_SOURCES_QUERY_OVERRIDES = {"cordis": ["full_projects_no_pdfs"]}


rule extract_core_v4_sources:
    """Extraction-only half of core_v4_sources."""
    input:
        _extract_targets(exclude=CORE_V4_SOURCES_EXCLUDE, only_queries=CORE_V4_SOURCES_QUERY_OVERRIDES),
        rules.download_ror_dump.output,
        rules.download_openaire_dump.output,


rule core_v4_sources:
    """Extract + load + report target: cordis (full_projects_no_pdfs only) +
    ror_dump + openaire_dump. See extract_core_v4_sources."""
    input:
        _report_targets(exclude=CORE_V4_SOURCES_EXCLUDE, only_queries=CORE_V4_SOURCES_QUERY_OVERRIDES),
        f"reports/sources/dumps/{REPORT_NAME_ROR_DUMP}.md",
        f"reports/sources/dumps/{REPORT_NAME_OPENAIRE_DUMP}.md",


# core_v4, end to end, in three chains so the results come in order of importance (see
# rules/pipeline/core_v4/*.smk and orchestration/README.md). None is part of `all`.
#   core_v4_projects      staging -> enrichments for entity project + organization -> assemble --entity project
#                         -> reports (staging, projects)
#   core_v4_works_linked  the project-linked works (tier 0, ~5M): enrichments --tier 0 -> assemble --tier 0
#                         -> reports (staging, works_linked). Its enrichments wait for the projects duckdb
#                         (ordering only), so it runs after the projects chain and pulls it in if missing.
#   core_v4_works         everything: core_v4_works_linked, then the org-only works (tier 1, the enrichments wait
#                         for their own tier 0) -> assemble --entity work -> reports (staging, works).
#   core_v4               all of it.
# `--config limit=N` runs the whole thing on the dev sample into separate *_limit files.
#   ENV=prod uv run snakemake -s orchestration/Snakefile --workflow-profile orchestration/profiles/slurm core_v4_projects
rule core_v4_projects:
    input:
        CORE_V4_PROJECTS_TARGETS,


rule core_v4_works_linked:
    input:
        CORE_V4_WORKS_LINKED_TARGETS,


rule core_v4_works:
    input:
        CORE_V4_WORKS_TARGETS,


rule core_v4:
    input:
        CORE_V4_PROJECTS_TARGETS,
        CORE_V4_WORKS_TARGETS,
