{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "30s",
    "codec": "default",
    "merge.scheduler.max_thread_count": 1,
    "translog.flush_threshold_size": "1gb",
    "analysis": {
      "filter": {
        "en_stem": {
          "type": "stemmer",
          "language": "light_english"
        }
      },
      "analyzer": {
        "hm_text": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding",
            "en_stem"
          ]
        },
        "hm_name": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id": {
        "type": "keyword"
      },
      "funder": {
        "type": "keyword"
      },
      "programme": {
        "type": "keyword"
      },
      "action": {
        "type": "keyword"
      },
      "description": {
        "type": "text",
        "analyzer": "hm_text",
        "fields": {
          "sayt": {
            "type": "search_as_you_type",
            "analyzer": "hm_name",
            "max_shingle_size": 3
          }
        }
      },
      "funder_name": {
        "type": "text",
        "analyzer": "hm_name",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "jurisdiction": {
        "type": "keyword"
      },
      "is_pseudo": {
        "type": "boolean"
      },
      "project_count": {
        "type": "integer"
      },
      "dch_project_count": {
        "type": "integer"
      },
      "total_funded_eur": {
        "type": "double"
      }
    }
  }
}
